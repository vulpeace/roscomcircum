{
    "log": {
        "level": "warn",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "remote",
                "type": "https",
                "server": "example-dns.com",
                "domain_resolver": "resolver"
            },
            {
                "tag": "resolver",
                "type": "https",
                "server": "77.88.8.8"
            }
        ]
    },
    "inbounds": [
        {
            "type": "tun",
            "mtu": 1500,
            "address": "172.19.0.1/30",
            "auto_route": true,
            "strict_route": true,
            "stack": "system"
        }
    ],
    "outbounds": [
        {
            "type": "vless",
            "tag": "proxy",
            "server": "",
            "server_port": 443,
            "flow": "xtls-rprx-vision",
            "tls": {
                "enabled": true,
                "server_name": "example.com",
                "utls": {
                    "enabled": true,
                    "fingerprint": "chrome"
                }
            },
            "uuid": ""
        },
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "protocol": "quic",
                "action": "reject",
                "method": "default"
            },
            {
                "port": 853,
                "outbound": "direct"
            },
            {
                "domain_suffix": [
                    ".ru",
                    ".xn--p1ai",
                    ".su"
                ],
                "rule_set": [
                    "geosite-private",
                    "geosite-category-ru",
                    "geosite-category-gov-ru",
                    "geosite-yandex",
                    "geosite-mailru",
                    "geosite-vk"
                ],
                "outbound": "direct"
            },
            {
                "ip_is_private": true,
                "rule_set": "geoip-ru",
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "geosite-private",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-private.srs",
                "download_detour": "direct"
            },
            {
                "type": "remote",
                "tag": "geosite-category-gov-ru",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-category-gov-ru.srs",
                "download_detour": "direct"
            },
            {
                "type": "remote",
                "tag": "geosite-yandex",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-yandex.srs",
                "download_detour": "direct"
            },
            {
                "type": "remote",
                "tag": "geosite-mailru",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-mailru.srs",
                "download_detour": "direct"
            },
            {
                "type": "remote",
                "tag": "geosite-vk",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-vk.srs",
                "download_detour": "direct"
            },
            {
                "type": "remote",
                "tag": "geoip-ru",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geoip/raw/rule-set/geoip-ru.srs",
                "download_detour": "direct"
            },
            {
                "type": "remote",
                "tag": "geosite-category-ru",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-category-ru.srs",
                "download_detour": "direct"
            }
        ],
        "auto_detect_interface": true,
        "default_domain_resolver": {
            "server": "remote",
            "strategy": "ipv4_only"
        }
    },
    "experimental": {
        "cache_file": {
            "enabled": true
        }
    }
}
